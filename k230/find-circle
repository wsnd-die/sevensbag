import time, os, sys, gc
from media.sensor import *          
from media.display import *         
from media.media import *           
from ybUtils.YbUart import YbUart   

uart = YbUart(baudrate=115200)
）
PICTURE_WIDTH = 200
PICTURE_HEIGHT = 120
DISPLAY_WIDTH = 640
DISPLAY_HEIGHT = 480

area_of_center = 100    
flag_circle = 1         


def receive_serial_data():
    data = uart.read(1)
    if data != None:
        return chr(data)
    return None


def init_sensor():
    sensor = Sensor(id=2)   # 使用摄像头通道 2
    sensor.reset()
    # 设置图像宽高（对应 PICTURE_WIDTH/HEIGHT）
    sensor.set_framesize(width=PICTURE_WIDTH, height=PICTURE_HEIGHT, chn=CAM_CHN_ID_0)
    # 设置为灰度图像格式
    sensor.set_pixformat(Sensor.GRAYSCALE, chn=CAM_CHN_ID_0)
    return sensor


def init_display():
    Display.init(Display.ST7701, width=DISPLAY_WIDTH, height=DISPLAY_HEIGHT, to_ide=True)


def callbacks(dat):
    global flag_circle
    if dat == 'o':
        flag_circle = 1


_sx = _sy = _sr = None   
_slost = 0               
_S_ALPHA = 0.15          
_S_FAST_ALPHA = 0.9      
_S_FAST_DIST = 15        
_S_GATE = 30             
_S_LOST = 5              


_DIR_REQUIRED = 3        
_dir_current = None      
_dir_count = 0          


class _SmoothCircle:
    """内部使用的圆对象封装，保存平滑后的圆心与半径。"""
    __slots__ = ("_x", "_y", "_r")   # 限制属性，节省内存

    def __init__(self, x, y, r):
        self._x, self._y, self._r = x, y, r

    def x(self):
        return self._x

    def y(self):
        return self._y

    def r(self):
        return self._r


def _stabilize(circles):
    """对当前帧检测到的圆列表做平滑防抖，返回稳定后的圆列表（最多 1 个）。"""
    global _sx, _sy, _sr, _slost

    # 本帧没有检测到圆：连续丢失计数 +1
    if not circles:
        _slost += 1
        if _slost > _S_LOST:            # 丢失超过阈值，放弃之前的状态
            _sx = _sy = _sr = None
            return []
        # 丢失帧数未超阈值：保持上一次的圆（延缓丢失，避免输出中断）
        return [_SmoothCircle(_sx, _sy, _sr)] if _sx is not None else []

    # 本帧检测到了圆：先挑选“强度/响应值”最大的圆作为基准
    try:
        best = max(circles, key=lambda c: c.magnitude())
    except AttributeError:
        best = max(circles, key=lambda c: c.r())

    # 若已有平滑历史，优先选择与上一帧圆心最接近的圆（防止目标误切换）
    if _sx is not None:
        near = min(circles, key=lambda c: (c.x() - _sx) ** 2 + (c.y() - _sy) ** 2)
        if (near.x() - _sx) ** 2 + (near.y() - _sy) ** 2 <= _S_GATE ** 2:
            best = near

    # 平滑系数随跳动幅度连续变化：跳得越远 alpha 越大、跟随越快；
    # 静止/小幅抖动时 alpha 最小、最平滑。避免“快速模式”开关反复切换造成步进。
    if _sx is not None:
        jump2 = (best.x() - _sx) ** 2 + (best.y() - _sy) ** 2
    else:
        jump2 = 0.0
    frac = min(1.0, jump2 / (_S_FAST_DIST ** 2))      # 0(静止) ~ 1(大幅跳动)
    a = _S_ALPHA + frac * (_S_FAST_ALPHA - _S_ALPHA)  # 自适应平滑系数

    # 指数滑动平均更新圆心坐标与半径
    if _sx is None:
        # 无历史状态时，直接采用当前检测值作为初始状态
        _sx, _sy, _sr = best.x(), best.y(), best.r()
    else:
        _sx = int(_sx * (1 - a) + best.x() * a + 0.5)   # 四舍五入取整
        _sy = int(_sy * (1 - a) + best.y() * a + 0.5)
        _sr = int(_sr * (1 - a) + best.r() * a + 0.5)

    _slost = 0   # 检测成功，清空丢失计数
    return [_SmoothCircle(_sx, _sy, _sr)]


def circle_detect(img):
    global _dir_current, _dir_count
    
    circles = _stabilize(img.find_circles(
        threshold=2000,   
        x_margin=10,      
        y_margin=10,      
        r_margin=10,      
        r_min=20,         
        r_max=30,         
        r_step=1,        
    ))

    for c in circles:
        img.draw_circle(c.x(), c.y(), c.r(), color=(255, 0, 0), thickness=3)
        circle_center_x = int(c.x())
        circle_center_y = int(c.y())
        circle_r = int(c.r())

        distance_of_center_x = circle_center_x - PICTURE_WIDTH / 2
        distance_of_center_y = circle_center_y - PICTURE_HEIGHT / 2
        square_distance_of_center_x = distance_of_center_x ** 2   
        square_distance_of_center_y = distance_of_center_y ** 2   

        if square_distance_of_center_x + square_distance_of_center_y < area_of_center:
            dat_pos = 'O'   # 处于中心区域
        elif square_distance_of_center_x > square_distance_of_center_y:
            dat_pos = 'W' if distance_of_center_x > 0 else 'E'  
        else:
            dat_pos = 'N' if distance_of_center_y > 0 else 'S'  

        # 方向滞回：只有同一方向连续出现 _DIR_REQUIRED 帧才更新输出，抑制边界抖动
        if dat_pos == _dir_current:
            _dir_count += 1
        else:
            _dir_current = dat_pos
            _dir_count = 1
        if _dir_count >= _DIR_REQUIRED:
            uart.write(bytearray([0xa3, 0xb3, ord(dat_pos), 0xff]))
            print(dat_pos)          # 同时在终端打印方向
        time.sleep(0.1)         # 短暂延时，避免发送过快


def main():
    try:
        sensor = init_sensor()      
        init_display()              
        MediaManager.init()         
        sensor.run()                

        x_offset = (DISPLAY_WIDTH - PICTURE_WIDTH) // 2
        y_offset = (DISPLAY_HEIGHT - PICTURE_HEIGHT) // 2

        while True:
            img = sensor.snapshot(chn=CAM_CHN_ID_0)   # 抓取一帧图像
            commands = receive_serial_data()          # 读取串口命令

            if commands:
                print("Received:", commands)
                callbacks(commands)
            elif flag_circle:
                circle_detect(img)

            Display.show_image(img, x=x_offset, y=y_offset)

    except KeyboardInterrupt as e:
        print("用户中断 / User interrupted: ", e)
    except Exception as e:
        print(f"发生错误 / Error occurred: {e}")
    finally:
        if 'sensor' in locals() and isinstance(sensor, Sensor):
            sensor.stop()
        Display.deinit()
        os.exitpoint(os.EXITPOINT_ENABLE_SLEEP)
        time.sleep_ms(100)
        MediaManager.deinit()


if __name__ == "__main__":
    main()   
